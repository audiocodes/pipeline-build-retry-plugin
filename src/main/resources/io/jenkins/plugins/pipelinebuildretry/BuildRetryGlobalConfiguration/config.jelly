<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="${descriptor.displayName}">
    <f:entry title="Retry builds on this controller" field="enabled">
      <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="Default timeout for regular expressions (ms)" field="regexpTimeoutMs">
      <f:number default="30000" min="1"/>
    </f:entry>
    <f:entry title="Send events" field="sendEvents">
      <f:checkbox/>
    </f:entry>
    <f:entry title="Send configured jobs" field="sendJobConfig">
      <f:checkbox/>
    </f:entry>
    <f:entry title="Events endpoint (OTLP/HTTP)" field="eventsEndpoint">
      <f:textbox/>
    </f:entry>
    <f:entry title="Events token" field="eventsCredentialsId">
      <c:select/>
    </f:entry>
    <f:entry title="Events service name" field="eventsServiceName">
      <f:textbox default="jenkins"/>
    </f:entry>
    <f:entry title="Events resource attributes" field="eventsResourceAttributes">
      <f:textarea/>
    </f:entry>
  </f:section>
</j:jelly>
