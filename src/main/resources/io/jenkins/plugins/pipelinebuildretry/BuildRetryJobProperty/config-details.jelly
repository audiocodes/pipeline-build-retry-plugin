<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Maximum number of retries" field="maxSchedule">
    <f:number default="0" min="-1"/>
  </f:entry>
  <f:entry field="rerunIfUnstable">
    <f:checkbox title="Rerun unstable builds as well as failures"/>
  </f:entry>
  <f:dropdownDescriptorSelector title="Delay before retrying" field="delay" default="${descriptor.defaultDelay}"/>
  <f:entry field="checkRegexp">
    <f:checkbox title="Only rerun if a regular expression is found in the log"/>
  </f:entry>
  <f:entry title="Regular expression" field="regexpForRerun">
    <f:textbox checkDependsOn="checkRegexp"/>
  </f:entry>
  <f:entry title="Where to search" field="regexpScope">
    <f:select default="build"/>
  </f:entry>
  <f:entry title="Timeout for the regular expression (ms)" field="regexpTimeoutMs">
    <f:textbox/>
  </f:entry>
  <f:entry title="Never retry if any of these is found in the log" field="neverRetryPatternsText">
    <f:textarea/>
  </f:entry>
  <f:entry title="Rerun aborted builds" field="rerunIfAborted">
    <f:select default="never"/>
  </f:entry>
  <f:entry field="rerunOnAgentLoss">
    <f:checkbox title="Rerun on agent loss, even when the regular expression is not found"/>
  </f:entry>
  <f:advanced>
    <f:entry title="Agent-loss patterns" field="agentLossPatternsText">
      <f:textarea/>
    </f:entry>
    <f:entry title="Extra agent-loss patterns" field="agentLossPatternsExtraText">
      <f:textarea/>
    </f:entry>
    <f:entry field="skipReplays">
      <f:checkbox title="Never rerun a Replay" default="true"/>
    </f:entry>
    <f:entry title="Gerrit Trigger cause on the retry" field="gerritCause">
      <f:select default="drop"/>
    </f:entry>
    <f:entry title="Causes not to copy" field="dropCausesText">
      <f:textarea/>
    </f:entry>
    <f:entry title="Parameter overrides" field="parameterOverridesText">
      <f:textarea/>
    </f:entry>
    <f:entry field="badge">
      <f:checkbox title="Show a badge on retried builds" default="true"/>
    </f:entry>
    <f:entry field="dryRun">
      <f:checkbox title="Dry run: decide and log, never queue"/>
    </f:entry>
    <f:entry field="verbose">
      <f:checkbox title="Log every gate of the decision"/>
    </f:entry>
  </f:advanced>
</j:jelly>
